    "android.dex-cache.download": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin download was interrupted. Check the connection and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件下载中断，请检查网络后重试。"}}}},
    "android.dex-cache.integrity": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The downloaded plugin did not pass verification. Try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载的插件未通过校验，请稍后重试。"}}}},
    "android.dex-cache.write": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The local plugin cache could not be updated. Try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地插件缓存无法更新，请重试。"}}}},
