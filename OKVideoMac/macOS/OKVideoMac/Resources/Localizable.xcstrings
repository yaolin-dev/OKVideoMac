    "configuration.action.timeout": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The operation timed out. Refresh the configuration to check its current state before retrying."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "操作等待超时。请刷新配置，确认当前状态后再重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "操作等待逾時。請重新整理設定，確認目前狀態後再重試。"}}}},
