    "settings.backup.restore.merge-note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the same history item exists twice, the record with the newer watch time is kept. Current providers and history are backed up before import. Cloud account authorization is never overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一条历史会保留观看时间更新的记录；导入前会自动备份当前配置和历史。网盘账号授权不会被覆盖。"
          }
        }
      }
    },
    "settings.backup.restore.safety-suffix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Your previous data was saved as a safety backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 导入前的数据已保存为安全备份。"
          }
        }
      }
    },
    "settings.backup.restore.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview the contents and automatically save current data before import"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
