    "android.external.issue.avd-image-mismatch": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The dedicated Android environment's API, ABI, or tag does not match the system image metadata."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"专用 Android 环境的 API、ABI、tag 与 system image 元数据不一致"}}}},
    "android.external.issue.avd-image-missing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The system image used by the dedicated Android environment is not present in the selected SDK."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"专用 Android 环境引用的 system image 不在所选 SDK 中"}}}},
    "android.external.issue.avd-incompatible": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The dedicated Android environment is incompatible with the existing SDK (%@). userdata was not modified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"专用 Android 环境与现有 SDK 不兼容（%@）；未修改 userdata"}}}},
    "android.external.issue.avd-incomplete": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The OKVideoMac Android environment folder is incomplete. Existing data was not overwritten."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"OKVideoMac 专用 Android 环境目录不完整；未自动覆盖现有数据"}}}},
    "android.external.issue.avdmanager-required": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"avdmanager is required to create or repair the dedicated Android environment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建或修复专用 Android 环境需要 avdmanager"}}}},
