    "player.audio.apply.failed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Audio setting could not be applied; your preference is saved."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "音量设置未能应用，已保留你的选择，可重试。"}}}},
