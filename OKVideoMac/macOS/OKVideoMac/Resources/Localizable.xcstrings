    "android.external.issue.tool-architecture": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ in the selected SDK does not support this Mac's architecture."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选 SDK 的 %@ 不支持当前 Mac 架构"}}}},
    "android.external.issue.tool-missing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected SDK is missing %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选 SDK 缺少 %@"}}}},
