{
  "sourceLanguage": "en",
  "strings": {
    "player.queue.choose-resource": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This episode has %d resources. Choose one to continue."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "该集有 %d 个资源，请选择一个继续播放。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "該集有 %d 個資源，請選擇一個繼續播放。"}}}},
    "player.queue.unresolved": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cannot determine an adjacent episode. Choose from the episode list."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法确定相邻分集，请从选集列表选择。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法確定相鄰分集，請從選集清單選擇。"}}}},
    "player.queue.show-all": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Show All Episodes"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看全部分集"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "查看全部分集"}}}},
    "player.previous-episode.choose": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose Previous Episode…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择上一集…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇上一集…"}}}},
    "player.next-episode.choose": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose Next Episode…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择下一集…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇下一集…"}}}},
    "updates.title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Software Updates"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "软件更新"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "軟體更新"}}}},
    "updates.check": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check for Updates…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "检查更新…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "檢查更新…"}}}},
    "updates.automatic": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Automatically Check for Updates"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动检查更新"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "自動檢查更新"}}}},
    "updates.consent-note": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Checks once a day. Download and installation require your confirmation."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "每天检查一次。下载和安装都需要你确认。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "每天檢查一次。下載和安裝都需要你確認。"}}}},
    "updates.unconfigured": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This build has no update feed configured."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此版本尚未配置更新源。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此版本尚未設定更新來源。"}}}},
    "updates.local-channel": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Local test channel · Keep the local update server running."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本地测试通道 · 请保持本机更新服务运行。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "本機測試通道 · 請保持本機更新服務運作。"}}}},
    "updates.stable-channel": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Stable channel"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "稳定通道"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "穩定通道"}}}},
    "updates.available": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Update Available"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "有新版本"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "有新版本"}}}},
    "updates.last-check": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Last checked"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "上次检查"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "上次檢查"}}}},
    "updates.busy.title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Update in Progress"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在更新"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在更新"}}}},
    "updates.restart-busy": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finish the current update before restarting the app."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先完成或取消更新，再重启应用。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先完成或取消更新，再重新啟動應用程式。"}}}},
    "updates.check-busy": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finish the current restart before checking for updates."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待当前重启完成后再检查更新。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請等待目前重新啟動完成後再檢查更新。"}}}},
    "updates.finishing.title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finishing playback cleanup"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在完成播放清理"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在完成播放清理"}}}},
    "updates.finishing.message": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The update is waiting for playback and history cleanup. Installation will continue when cleanup finishes."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "更新正在等待播放器与历史记录清理完成。清理完成后将继续安装。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "更新正在等待播放器與歷史記錄清理完成。清理完成後將繼續安裝。"}}}},
    "detail.source-updated": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This source's configuration changed. Retry to load the updated details."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前源的配置已更新，请重试加载详情。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "目前來源的設定已更新，請重試載入詳情。"}}}},
