    "player.resource-count": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%d resources"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%d 个资源"}}}},
    "episode.issue": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Issue %d"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "第 %d 期"}}}},
    "episode.finale": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finale"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "大结局"}}}},
    "player.seek.wait-timeout": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Seeking is taking too long. Retry this position or choose another position."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "跳转等待较久，可重新尝试或选择其他位置。"}}}},
    "detail.authorization.pending": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Complete authorization, then retry loading details."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "完成授权后，可在此重试加载详情。"}}}},
    "detail.request-cancelled": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Detail loading was interrupted. You can retry here."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "详情加载已中断，可在此重试。"}}}},
    "detail.request-timeout": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This provider is taking too long. Your page is preserved; you can retry."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "来源响应超时，已保留当前页面，可重试加载。"}}}},
    "detail.search-returned": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This provider returned a search suggestion instead of details. Retry or continue searching."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "来源返回了搜索建议，未取得影片详情。可重试或继续搜索。"}}}},
    "detail.continue-search": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Continue Searching"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "继续搜索"}}}},
