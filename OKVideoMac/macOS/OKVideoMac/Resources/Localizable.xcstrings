    "settings.android.uninstall.cleanup-pending": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Components are uninstalled, but some files still need cleanup. Android user data was kept. Retry cleanup before installing again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"组件已卸载，但部分文件仍待清理。Android 用户数据已保留，请先重试清理再重新安装。"}}}},
