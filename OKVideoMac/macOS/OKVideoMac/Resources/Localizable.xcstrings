    "browser.refresh.again": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh All in This Scope"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新刷新当前范围"}}}},
    "search.filters.all": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"All Results"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全部结果"}}}},
