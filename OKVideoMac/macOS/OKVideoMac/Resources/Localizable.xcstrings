    "settings.android.uninstall.busy": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Another Android operation is in progress. Wait for it to finish before trying again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"其他 Android 操作正在进行，请等待完成后再试。"}}}},
