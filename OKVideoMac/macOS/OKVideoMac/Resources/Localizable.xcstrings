    "search.browse.loading": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Searching for more results…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在搜索更多结果…"}}}},
    "search.browse.stopped": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Search stopped; results retained"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索已停止，已保留现有结果"}}}},
    "search.browse.paused": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"More sources found; continue loading when ready"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已补充影片来源，可继续加载"}}}},
    "search.browse.partial": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Some providers need attention; other results can continue"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分来源异常，其他来源可继续加载"}}}},
    "search.browse.continue": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"More results are available"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可继续加载搜索结果"}}}},
    "search.browse.failed": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Some providers failed; results retained"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分来源加载失败，已保留现有结果"}}}},
    "search.browse.limited": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Further paging is not confirmed for this provider"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分来源的后续分页尚未确认支持"}}}},
    "search.browse.complete": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"All results in this scope have loaded"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前范围的搜索结果已全部加载"}}}},
    "search.browse.pending": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No further page has been confirmed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未确认后续页面"}}}},
    "search.browse.resume": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue / Retry"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续 / 重试"}}}},
    "search.browse.sources": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%d sources"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 个来源"}}}},
    "search.browse.source-empty": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This provider has no results yet. Check its search status or retry below."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此来源尚无搜索结果，可查看搜索状态或在下方重试。"}}}},
    "search.folder.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Folder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件夹"}}}},
    "search.browse.provider-count": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@: %d results"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@: %d 条结果"}}}},
    "pagination.uncertain": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No new titles; the end of results is not confirmed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂未获得新内容，尚不能确认是否已加载完"}}}},
    "cloud.authorization.media-check": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Playback failed, but account expiration has not been confirmed. Check cloud authorization here; after saving, the app will verify and resume only the current title once."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"播放未成功，但尚未确认账号授权失效。可以在此检查网盘授权；保存后只验证并恢复当前影片一次。"}}}},
    "player.quark.media-rejected": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Quark rejected a video request (HTTP %lld). This does not by itself mean your account authorization has expired. Retry or check authorization."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"夸克拒绝了视频请求（HTTP %lld），尚不能据此认定账号授权过期。可以重试或检查授权。"}}}},
    "player.quark.rate-limited": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Quark is limiting requests. Wait a moment before trying again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"夸克暂时限制了请求频率，请稍后重试，无需删除授权。"}}}},
