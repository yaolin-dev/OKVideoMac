    "android.external.issue.sdk-folder-missing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The previously configured Android SDK folder no longer exists."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以前配置的 Android SDK 文件夹已不存在"}}}},
