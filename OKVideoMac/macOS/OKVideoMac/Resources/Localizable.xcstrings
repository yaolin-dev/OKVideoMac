    "android.external.status.create-on-start": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Available; a dedicated Android environment will be created on first launch."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用；首次启动时将创建专用 Android 环境"}}}},
    "android.external.status.ready": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Available; the existing dedicated Android environment can start directly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用；可以直接启动现有专用 Android 环境"}}}},
    "android.external.status.rebuild-required": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The SDK is available, but the existing dedicated Android environment is incompatible. After switching, explicitly choose Back Up and Rebuild."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"SDK 可用，但现有专用 Android 环境不兼容；切换后需要由用户明确执行备份并重建"}}}},
    "android.external.status.unavailable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The existing Android SDK configuration is unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现有 Android SDK 配置不可用"}}}},
    "android.failure.adb-device-missing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android Emulator is still running, but ADB did not find the target device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Emulator 仍在运行，但 ADB 未发现目标设备。"}}}},
    "android.failure.adb-offline": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"ADB found the dedicated Android Emulator, but the device remained offline."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ADB 已发现专用 Android Emulator，但设备一直处于 offline 状态。"}}}},
    "android.failure.adb-reconnect": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The bounded ADB reconnect for the dedicated Android Emulator failed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"专用 Android Emulator 的有界 ADB 重连失败。"}}}},
    "android.failure.adb-unavailable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"ADB is unavailable, so the dedicated Android Emulator cannot be connected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ADB 无法使用，无法连接专用 Android Emulator。"}}}},
    "android.failure.avd-rebuild": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The dedicated Android Runtime could not start with hardware or software rendering. Rebuild the Runtime in Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"专用 Android Runtime 使用硬件和软件渲染均无法启动；请在设置中重建 Runtime。"}}}},
    "android.failure.boot-timeout": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android startup timed out before the compatibility environment became ready."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android 系统启动超时，兼容环境没有在预期时间内完成启动。"}}}},
    "android.failure.bridge-identity": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The detected Android Bridge does not belong to this launch instance. The connection was rejected; restart the compatibility environment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检测到的 Android Bridge 不属于当前启动实例；已拒绝连接，请重新启动兼容环境。"}}}},
    "android.failure.bridge-install": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android Bridge installation failed. Reinstall the app or export diagnostics."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Bridge 安装失败，请重新安装测试版或导出诊断。"}}}},
    "android.failure.bridge-launch": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android Bridge failed to start. Use Repair, then try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Bridge 服务启动失败，请使用“修复”后重试。"}}}},
    "android.failure.bridge-timeout": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android Bridge did not connect in time. Startup failed; try again or use Repair."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Bridge 未在限定时间内建立连接；本次启动已失败，请重试或使用“修复”。"}}}},
    "android.failure.bridge-version": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android Bridge does not match this app version. Use Repair to reinstall the current Bridge."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Bridge 与当前 App 版本不一致；请使用“修复”重新安装当前 Bridge。"}}}},
    "android.failure.cancelled": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android Emulator startup was cancelled or ended by the app."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Emulator 启动已由 App 取消或结束。"}}}},
    "android.failure.emulator-launch": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android Emulator did not start normally. Export diagnostics, then try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Emulator 未能正常启动，请导出诊断后重试。"}}}},
    "android.failure.host-port": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The local Android Bridge port is in use. Close the conflicting app and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机 Android Bridge 端口被占用，请关闭冲突程序后重试。"}}}},
    "android.failure.java-missing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A Java Runtime is required to create the dedicated Android environment. Install a JDK or Android Studio with JBR."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建专用 Android 环境需要 Java Runtime。请安装 JDK，或安装包含 JBR 的 Android Studio。"}}}},
    "android.failure.network": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android Emulator did not establish a usable network. Check your network and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Emulator 没有建立可用网络，请检查网络后重试。"}}}},
    "android.failure.ownership": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The dedicated Android Emulator could not be identified safely. No other devices were modified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法安全确认专用 Android Emulator，已停止操作其他设备。"}}}},
    "android.failure.port-conflict": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A port required by Android Emulator is in use. The occupying process was not terminated."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Emulator 所需端口被其他进程占用，未终止占用进程。"}}}},
    "android.failure.port-forward": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"ADB port mapping failed, so Android Bridge cannot connect to the Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ADB 端口映射失败，Android Bridge 无法连接到 Mac。"}}}},
    "android.failure.private-adb": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"OKVideoMac could not start its isolated ADB service. The system ADB service was not connected or stopped."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"OKVideoMac 无法启动独立的 ADB 服务；没有连接或关闭系统默认 ADB。"}}}},
    "android.failure.process-mismatch": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Android Emulator PID no longer belongs to this launch instance."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android Emulator PID 已不再属于本次启动实例。"}}}},
    "android.failure.runtime-conflict": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Another Emulator is using the dedicated AVD or recorded port. No action was taken."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检测到其他 Emulator 正在使用专用 AVD 或记录端口，未执行任何操作。"}}}},
    "android.failure.sdk-incomplete": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Android SDK is incomplete. In Settings, choose an SDK containing ADB, Emulator, and a system image."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android SDK 不完整，请在设置中选择包含 ADB、Emulator 和系统镜像的 SDK。"}}}},
    "android.failure.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Android Compatibility Environment Failed to Start"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android 兼容环境启动失败"}}}},
    "android.failure.unexpected-device": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"ADB found another Emulator but not the device expected for this launch."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"ADB 发现了其他 Emulator，但没有发现本次启动所预期的设备。"}}}},
    "android.failure.unknown": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Android compatibility environment failed to start. Export diagnostics now."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Android 兼容环境启动失败，请立即导出诊断信息。"}}}},
