{
  "spider": "./fixture.jar",
  "wallpaper": "./wallpaper.jpg",
  "logo": "./logo.png",
  "notice": "仅用于协议测试",
  "sites": [
    {
      "key": "fixture",
      "name": "合法测试站点",
      "type": 1,
      "api": "https://example.invalid/api",
      "ext": {"mode": "fixture"},
      "searchable": 1,
      "changeable": 1,
      "quickSearch": 1,
      "header": {"User-Agent": "OKVideoMacTests"},
      "futureSiteField": "kept"
    }
  ],
  "parses": [
    {
      "name": "fixture-parser",
      "type": 1,
      "url": "https://example.invalid/parse?url=",
      "ext": {
        "flag": ["fixture"],
        "header": {"Referer": "https://example.invalid/"}
      }
    }
  ],
  "lives": [
    {
      "name": "fixture-live",
      "groups": [
        {
          "name": "Public domain",
          "channel": [
            {
              "name": "Local fixture",
              "urls": ["https://example.invalid/fixture.m3u8"]
            }
          ]
        }
      ]
    }
  ],
  "doh": [
    {
      "name": "fixture-doh",
      "url": "https://example.invalid/dns-query",
      "ips": ["192.0.2.1"]
    }
  ],
  "proxy": [
    {
      "name": "fixture-proxy",
      "urls": ["http://127.0.0.1:7890"],
      "hosts": ["*.example.invalid"]
    }
  ],
  "rules": [
    {
      "name": "fixture-rule",
      "hosts": ["example.invalid"],
      "regex": [".*fixture.*"],
      "script": ["fixture-script"],
      "exclude": ["fixture-exclude"]
    }
  ],
  "headers": [
    {
      "host": "example.invalid",
      "header": {"Access-Control-Allow-Origin": "*"}
    }
  ],
  "hosts": ["example.invalid=192.0.2.2"],
  "flags": ["fixture"],
  "ads": ["ads.example.invalid"],
  "danmaku": "https://example.invalid/danmaku",
  "futureTopLevel": {"enabled": true}
}
