<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The self-contained Release app loads the bundled libmpv bridge with
	dlopen. Local/ad-hoc builds do not have a Team ID, so hardened runtime
	library validation would otherwise reject the bundled dylibs even though
	the complete app bundle passes codesign verification.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
